{
  "name": "playwright-tutorial",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:exercises": "playwright test tests/exercises",
    "test:solutions": "playwright test tests/solutions"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.0"
  }
}
